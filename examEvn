# ===================================================================
# 🚀 Rio BA — Environment Configuration File Template (examEvn)
# ===================================================================
# Instructions:
# 1. Rename this file to `.env` or create a new `.env` file with these values.
# 2. Add your API keys from the respective providers below.
# 3. Rio BA will automatically detect and load your configured keys.
# ⚠️ NEVER commit your actual `.env` file to GitHub!
# ===================================================================

# ── 1. Google Gemini API (Recommended & Default: Gemini 3.8 Flash) ──
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Groq Cloud APIs (High-speed Llama 3.3 70B & GPT-OSS) ────────
# Get your free keys at: https://console.groq.com/keys
# You can provide one or two keys for automatic load balancing
GROQ_API_KEY_1=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_2=gsk_your_backup_groq_api_key_here

# ── 3. OpenRouter API (Access to 200+ models with Auto Routing) ─────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── 4. Ollama (100% Local or Remote Offline LLM) ────────────────────
# Run models locally for free without any API keys!
# Examples:
#   localhost         -> if Ollama is running on the same PC
#   192.168.1.50      -> if Ollama is running on another machine in your network
OLLAMA_HOST=localhost
